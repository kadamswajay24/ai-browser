{
  "name": "ai-browser",
  "version": "1.0.0",
  "description": "Chromium-based autonomous AI browser with local Ollama integration",
  "author": "Swajay Chandrakant Kaddam <kadamswajay24@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadamswajay24/ai-browser.git"
  },
  "keywords": [
    "electron",
    "browser",
    "ai-agent",
    "ollama",
    "qwen",
    "autonomous-agent"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "test": "node tests/test-runner.js && node tests/moodle-extraction-test.js"
  },
  "build": {
    "appId": "com.aibrowser.app",
    "productName": "AI Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.6.4",
    "jsdom": "^30.1.3"
  }
}
